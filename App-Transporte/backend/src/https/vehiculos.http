@url = http://localhost:8000

# @name login
POST {{url}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "admin1234"
}

###

@token = {{login.response.body.token}}

### Listar vehículos
GET {{url}}/api/vehiculos
Authorization: Bearer {{token}}

### Crear vehículo
POST {{url}}/api/vehiculos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Ford",
  "modelo": "F-100",
  "patente": "AB123CD",
  "anio": 2020,
  "capacidad_carga": 1500
}

### Editar vehículo
PUT {{url}}/api/vehiculos/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "marca": "Ford",
  "modelo": "F-150",
  "patente": "AB123CD",
  "anio": 2021,
  "capacidad_carga": 2000
}

### Eliminar vehículo
DELETE {{url}}/api/vehiculos/1
Authorization: Bearer {{token}}
